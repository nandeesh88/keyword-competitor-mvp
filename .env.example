# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keyword_mvp"
# Alternatively provide individual Postgres variables used by docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=keyword_mvp

# Google Custom Search API
GOOGLE_CSE_API_KEY="your_google_api_key_here"
GOOGLE_CSE_CX="your_search_engine_id_here"

# Groq API (free tier)
GROQ_API_KEY="your_groq_api_key_here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REPORTS_DIR="./reports"
